# Default remains dry_run. Native Graph commands additionally require --confirm-live.
INSTABAY_MODE=dry_run
INSTABAY_DB_PATH=outputs/demo.sqlite3
INSTABAY_CHECKPOINTS_PATH=outputs/demo-checkpoints.sqlite3
INSTABAY_OUTBOX_PATH=outbox/demo
# HUMAN: create keys and tokens; copy this file to the git-ignored .env.
GOOGLE_API_KEY=
GROQ_API_KEY=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
