# Default remains dry_run. Native Graph commands additionally require --confirm-live.
INSTABAY_MODE=dry_run
INSTABAY_DB_PATH=outputs/demo.sqlite3
INSTABAY_CHECKPOINTS_PATH=outputs/demo-checkpoints.sqlite3
INSTABAY_OUTBOX_PATH=outbox/demo
# HUMAN: create keys and tokens; copy this file to the git-ignored .env.
GOOGLE_API_KEY=
GROQ_API_KEY=
# Real local generation is opt-in; access the loopback GPU service through an SSH tunnel.
INSTABAY_LLM_ENABLED=0
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# HUMAN: enable only for intentional decision inference/recording; no default native engine.
INSTABAY_DECISIONS_ENABLED=0
INSTABAY_SYSTEMONE_API_KEY=
# HUMAN: launch only on gpu-box after pinned runtime/weight/crop review; restrict Tailscale ACLs.
INSTABAY_VIDEO_ENABLED=0
INSTABAY_VIDEO_BACKEND=stub
INSTABAY_WORKER_TOKEN=
INSTABAY_WORKER_ROOT=.
INSTABAY_RENDERS_PATH=renders
INSTABAY_WORKER_IMAGE_DIGEST=
INSTABAY_GPU_DRIVER=
INSTABAY_WORKER_RECIPE=
# Standalone measured Wan preview, separate from the pinned production worker.
INSTABAY_GPU_ENABLED=0
