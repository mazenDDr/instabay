FROM ghcr.io/astral-sh/uv:0.13.0@sha256:cdc6093146eb3ff6a40107b38f008b789e050e77ad87865e381d9917da55a168 AS uv
FROM python:3.12-slim@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1
COPY --from=uv /uv /usr/local/bin/uv
RUN apt-get update && apt-get install -y --no-install-recommends git make ffmpeg && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV UV_PYTHON_DOWNLOADS=never \
    UV_LINK_MODE=copy \
    INSTABAY_MODE=dry_run \
    INSTABAY_DB_PATH=outputs/clone-demo.sqlite3 \
    INSTABAY_CHECKPOINTS_PATH=outputs/clone-checkpoints.sqlite3 \
    INSTABAY_OUTBOX_PATH=outbox/clone-demo \
    PATH="/app/.venv/bin:$PATH"
# This target is for a fresh committed checkout. Git metadata is needed by make setup/hooks.
# Personal caches, state, keys and environment files are excluded by the Dockerfile-specific ignore.
COPY . .
RUN make setup && mkdir -p outputs && chown -R 10001:10001 /app
ENV UV_OFFLINE=1
USER 10001:10001
CMD ["sh", "scripts/verify_clone.sh"]
